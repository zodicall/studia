# Language: en | tr (auto-detected from OS locale if unset)
# STUDIA_LANG=en

# AI Provider: auto | gemini | openai | agy | claude | codex | gemini-cli | custom
STUDIA_AI_PROVIDER=auto

# Optional model override (defaults: gemini-2.5-flash / gpt-4o-mini / CLI default)
# STUDIA_AI_MODEL=gemini-2.5-flash

# Optional custom OpenAI-compatible or Gemini API base URL (e.g. http://localhost:11434/v1 for Ollama)
# STUDIA_AI_BASE_URL=https://api.openai.com/v1

# HTTP API keys (never logged or passed to child CLI environments)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Custom CLI template when STUDIA_AI_PROVIDER=custom (supports {prompt_file} and {schema_file})
# STUDIA_AI_CMD=my-ai-cli --schema {schema_file} --prompt-file {prompt_file}

# Subprocess AI timeout in seconds (default: 180; 0 disables timeout)
# STUDIA_AI_TIMEOUT_SECS=180

# Telegram Bot (required only for `studia listen` or F2 background listener in TUI)
STUDIA_TELEGRAM_TOKEN=
STUDIA_TELEGRAM_CHAT_ID=
# Daily morning check-in time in local HH:MM format
# STUDIA_MORNING=08:30
